msgstr "استيراد بيانات علاقات العملاء"

#. module: jakh_migration
#: model_terms:ir.ui.view,arch_db:jakh_migration.view_crm_import
msgid ""
"Only CRM opportunities are imported. Original financial fields are "
"protected. Review sample-versus-real data before loading. Passwords, opening"
" balances and accounting history are never guessed."
msgstr ""
"تُستورد فرص علاقات العملاء فقط. الحقول المالية الأصلية محمية. ميّز بين "
"البيانات التجريبية والحقيقية قبل التحميل. لا تُخمَّن كلمات المرور أو الأرصدة"
" الافتتاحية أو السجل المحاسبي مطلقاً."

#. module: jakh_migration
#. odoo-python
#: code:addons/jakh_migration/migration.py:0
msgid "Original amounts cannot be negative or non-finite."
msgstr "لا يمكن أن تكون المبالغ الأصلية سالبة أو غير محدودة."

#. module: jakh_migration
#. odoo-python
#: code:addons/jakh_migration/migration.py:0
msgid "Original amounts must be finite non-negative decimal numbers."
msgstr "يجب أن تكون المبالغ الأصلية أعداداً عشرية محدودة وغير سالبة."

#. module: jakh_migration
#. odoo-python
#: code:addons/jakh_migration/migration.py:0
msgid "Original amounts must be numeric."
msgstr "يجب أن تكون المبالغ الأصلية رقمية."

#. module: jakh_migration
#. odoo-python
#: code:addons/jakh_migration/migration.py:0
msgid "Provide between 1 and 20,000 CRM opportunity records."
msgstr "قدّم ما بين 1 و20,000 سجل لفرص علاقات العملاء."

#. module: jakh_migration
#: model:ir.model.fields,field_description:jakh_migration.field_jakh_crm_import__result
msgid "Result"
msgstr "النتيجة"

#. module: jakh_migration
#. odoo-python
#: code:addons/jakh_migration/migration.py:0
