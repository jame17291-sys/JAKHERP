         domains, create/import controls and all existing access rules. -->
    <record id="crm_lead_list_without_sample" model="ir.ui.view">
        <field name="name">JAKH crm_case_tree_view_leads shows actual records</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_leads"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="sample">0</attribute>
