    <record id="crm_neutral_website_placeholder" model="ir.ui.view">
        <field name="name">JAKH CRM neutral website example</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='website']" position="attributes">
                <attribute name="placeholder">https://example.com</attribute>
            </xpath>
        </field>
    </record>

    <!-- Native sales-team actions render this helper. Keep their configured
         mail alias usable, without suggesting that live CRM is a playground
         or that the email gateway should be tested with business records. -->
    <template id="crm_professional_empty_help" inherit_id="crm.crm_action_helper" priority="99">
        <xpath expr="//t[@t-if='team.alias_email']" position="replace">
            <t t-if="team.alias_email">
                <p class="o_view_nocontent_smiling_face">No leads or opportunities match this view</p>
                <p>Create a lead or opportunity with New, import reviewed records, or adjust your filters.</p>
                <p>Use the configured team email to record an enquiry:
                    <a t-attf-href="mailto:#{team.alias_email}"><t t-out="team.alias_email"/></a>
                </p>
            </t>
        </xpath>
        <xpath expr="//t[@t-else]" position="replace">
            <t t-else="">
                <p class="o_view_nocontent_smiling_face">No leads or opportunities match this view</p>
                <p>Create a lead or opportunity with New, import reviewed records, or adjust your filters.</p>
            </t>
        </xpath>
    </template>
