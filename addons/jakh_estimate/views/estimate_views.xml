<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_estimate_search" model="ir.ui.view">
        <field name="name">jakh.estimate.search</field>
        <field name="model">jakh.estimate</field>
        <field name="arch" type="xml">
            <search string="Construction estimates">
                <field name="name"/>
                <field name="title"/>
                <field name="partner_id"/>
                <field name="opportunity_id"/>
                <field name="estimator_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="currency_id" groups="jakh_core.group_financial"/>
                <filter name="my_studies" string="My studies" domain="[('estimator_id', '=', uid)]"/>
                <separator/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="review" string="Awaiting approval" domain="[('state', '=', 'review')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="handed_over" string="Handed over" domain="[('state', '=', 'handed_over')]"/>
                <separator/>
                <filter name="group_customer" string="Customer" context="{'group_by': 'partner_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_estimator" string="Estimator" context="{'group_by': 'estimator_id'}"/>
                <filter name="group_currency" string="Currency" context="{'group_by': 'currency_id'}" groups="jakh_core.group_financial"/>
            </search>
        </field>
    </record>
    <record id="view_estimate_list" model="ir.ui.view">
        <field name="name">jakh.estimate.list</field>
        <field name="model">jakh.estimate</field>
        <field name="arch" type="xml">
            <list string="Construction estimates" decoration-info="state == 'review'" decoration-success="state in ('approved', 'handed_over')">
                <field name="name"/>
                <field name="title"/>
                <field name="partner_id"/>
                <field name="unit_count" optional="show"/>
                <field name="estimator_id" widget="many2one_avatar_user"/>
                <field name="create_date" optional="hide"/>
                <field name="currency_id" groups="jakh_core.group_financial"/>
                <field name="cost_amount" groups="jakh_core.group_financial" optional="hide"/>
                <field name="sell_amount" groups="jakh_core.group_financial"/>
                <field name="margin_amount" groups="jakh_core.group_financial" optional="hide"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="activity_ids" widget="list_activity" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_estimate_form" model="ir.ui.view">
        <field name="name">jakh.estimate.form</field>
        <field name="model">jakh.estimate</field>
        <field name="arch" type="xml">
            <form string="Construction estimate">
                <header>
                    <button name="action_submit" type="object" string="Submit for approval" class="btn-primary" invisible="state != 'draft'" groups="jakh_core.group_estimator,jakh_core.group_manager"/>
                    <button name="action_boq_intake" type="object" string="Import BOQ workbooks" invisible="state != 'draft'" groups="jakh_core.group_estimator,jakh_core.group_manager"/>
                    <button name="action_return_to_draft" type="object" string="Return to draft" invisible="state != 'review'" groups="jakh_core.group_manager"/>
                    <button name="action_approve" type="object" string="Approve &amp; lock" class="btn-primary" invisible="state != 'review'" groups="jakh_core.group_manager" confirm="Approve this study and lock its BOQ, quantities and pricing?"/>
                    <button name="action_handover" type="object" string="Create quotation &amp; project" class="btn-primary" invisible="state != 'approved'" groups="jakh_core.group_manager"/>
                    <button name="action_new_revision" type="object" string="New revision" invisible="state not in ('approved', 'handed_over', 'cancel')" groups="jakh_core.group_estimator,jakh_core.group_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,review,approved,handed_over"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_versions" type="object" class="oe_stat_button" icon="history"><field name="version_count" widget="statinfo" string="Versions"/></button>
                        <button name="action_open_quotation" type="object" class="oe_stat_button" icon="receipt" invisible="not sale_order_id" groups="jakh_core.group_financial"><span>Quotation</span></button>
                        <button name="action_open_project" type="object" class="oe_stat_button" icon="domain" invisible="not project_id"><span>Project</span></button>
                    </div>
                    <div class="oe_title"><h1><field name="name"/></h1><h2><field name="title" readonly="state != 'draft'" placeholder="Tender / scope title"/></h2></div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="opportunity_id" readonly="state != 'draft'"/>
                            <field name="estimator_id" readonly="state != 'draft'"/>
                            <field name="project_manager_id" readonly="state != 'draft'"/>
                            <field name="origin_estimate_id" invisible="not origin_estimate_id"/>
                        </group>
                        <group>
                            <field name="company_id" readonly="state != 'draft'" groups="base.group_multi_company"/>
                            <field name="currency_id" readonly="state != 'draft'" groups="jakh_core.group_financial"/>
                            <field name="unit_count" readonly="state != 'draft'"/>
                            <field name="header_markup_percent" readonly="state != 'draft'" groups="jakh_core.group_financial"/>
                            <field name="indirect_amount" readonly="state != 'draft'" groups="jakh_core.group_financial"/>
                            <field name="unallocated_indirect_amount" groups="jakh_core.group_financial" invisible="not unallocated_indirect_amount"/>
                            <field name="overhead_percent" readonly="state != 'draft'" groups="jakh_core.group_financial"/>
                            <field name="profit_percent" readonly="state != 'draft'" groups="jakh_core.group_financial"/>
                            <field name="pricing_basis" groups="jakh_core.group_financial"/>
                            <field name="approved_by_id" invisible="not approved_by_id"/>
                            <field name="approved_at" invisible="not approved_at"/>
                            <field name="sale_order_id" invisible="1"/>
                            <field name="project_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="BOQ &amp; assemblies" name="boq">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom" open_form_view="1">
                                    <field name="sequence" widget="handle"/>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="is_group" optional="show"/>
                                    <field name="parent_line_id" domain="[('estimate_id','=',parent.id),('is_group','=',True)]" optional="show"/>
                                    <field name="allocation_percent" groups="jakh_core.group_financial" optional="show"/>
                                    <field name="cost_code_id" optional="show"/>
                                    <field name="product_id" optional="hide"/>
                                    <field name="uom_id"/>
                                    <field name="quantity"/>
                                    <field name="unit_cost" groups="jakh_core.group_financial"/>
                                    <field name="item_markup_percent" groups="jakh_core.group_financial"/>
                                    <field name="total_quantity" readonly="1"/>
                                    <field name="currency_id" column_invisible="True" groups="jakh_core.group_financial"/>
                                    <field name="cost_amount" groups="jakh_core.group_financial" optional="hide"/>
                                    <field name="indirect_allocated" groups="jakh_core.group_financial" optional="hide"/>
                                    <field name="budget_total" groups="jakh_core.group_financial" optional="hide"/>
                                    <field name="sell_amount" groups="jakh_core.group_financial"/>
                                </list>
                                <form string="BOQ line">
                                    <sheet>
                                        <group><group><field name="estimate_id" invisible="1"/><field name="company_id" invisible="1"/><field name="code"/><field name="name"/><field name="is_group"/><field name="parent_line_id" domain="[('estimate_id','=',estimate_id),('is_group','=',True)]"/><field name="allocation_percent" groups="jakh_core.group_financial"/><field name="cost_code_id"/><field name="product_id"/><field name="line_uuid" readonly="1"/><field name="import_row_id" groups="jakh_core.group_financial" invisible="not import_row_id"/></group><group><field name="uom_id"/><field name="quantity"/><field name="unit_cost" groups="jakh_core.group_financial"/><field name="item_markup_percent" groups="jakh_core.group_financial"/><field name="secondary_uom_id"/><field name="conversion_factor"/><field name="total_quantity"/><field name="secondary_quantity"/></group></group>
                                        <notebook><page string="Resource assembly">
                                            <p class="text-muted">Resources are quantities per one primary BOQ unit. An assembly determines the unit cost when resources are present.</p>
                                            <field name="resource_ids"><list editable="bottom"><field name="resource_type"/><field name="name"/><field name="uom_id"/><field name="quantity"/><field name="unit_cost" groups="jakh_core.group_financial"/></list></field>
                                        </page><page string="Calculated totals" groups="jakh_core.group_financial"><group><field name="currency_id"/><field name="effective_unit_cost"/><field name="selling_unit_rate"/><field name="cost_amount"/><field name="sell_amount"/></group></page></notebook>
                                    </sheet>
                                </form>
                            </field>
                            <group class="oe_subtotal_footer" groups="jakh_core.group_financial"><field name="cost_amount"/><field name="budget_amount"/><field name="sell_amount"/><field name="margin_amount"/></group>
                        </page>
                        <page string="Building quantities" name="buildings">
                            <p class="text-muted">Unlisted buildings use the per-building BOQ quantity. A listed override replaces that quantity for its building; zero is a valid omitted item.</p>
                            <field name="building_ids" readonly="state != 'draft'">
                                <list editable="bottom" open_form_view="1"><field name="number"/><field name="name"/></list>
                                <form string="Building quantity basis"><sheet><group><field name="estimate_id" invisible="1"/><field name="number"/><field name="name"/></group><field name="override_ids"><list editable="bottom"><field name="estimate_id" column_invisible="True"/><field name="line_id" domain="[('estimate_id', '=', parent.estimate_id)]"/><field name="quantity"/></list></field></sheet></form>
                            </field>
                        </page>
                        <page string="Study versions" name="versions">
                            <group invisible="state != 'draft'" groups="jakh_core.group_estimator,jakh_core.group_manager"><field name="version_label"/><button name="action_save_version" string="Save study version" type="object" class="btn-secondary"/></group>
                            <field name="approved_version_id" invisible="not approved_version_id"/>
                            <field name="version_ids" readonly="1"><list create="0" edit="0" delete="0"><field name="number"/><field name="name"/><field name="created_by_id"/><field name="create_date"/><field name="added_count"/><field name="removed_count"/><field name="modified_count"/><field name="currency_id" groups="jakh_core.group_financial"/><field name="sell_amount" groups="jakh_core.group_financial"/></list></field>
                        </page>
                        <page string="Notes" name="notes"><field name="note" readonly="state != 'draft'"/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_estimate_kanban" model="ir.ui.view">
        <field name="name">jakh.estimate.kanban</field><field name="model">jakh.estimate</field>
        <field name="arch" type="xml"><kanban default_group_by="state" quick_create="false" records_draggable="false"><field name="state"/><field name="currency_id" groups="jakh_core.group_financial"/><templates><t t-name="card"><div class="fw-bold"><field name="name"/> · <field name="title"/></div><field name="partner_id"/><div groups="jakh_core.group_financial"><field name="sell_amount" widget="monetary"/></div><footer><field name="estimator_id" widget="many2one_avatar_user"/><field name="activity_ids" widget="kanban_activity"/></footer></t></templates></kanban></field>
    </record>
    <record id="view_estimate_activity" model="ir.ui.view"><field name="name">jakh.estimate.activity</field><field name="model">jakh.estimate</field><field name="arch" type="xml"><activity string="Estimate Activities"><templates><div t-name="activity-box"><field name="name"/><field name="title"/><field name="partner_id"/></div></templates></activity></field></record>
    <record id="view_estimate_pivot" model="ir.ui.view"><field name="name">jakh.estimate.pivot</field><field name="model">jakh.estimate</field><field name="arch" type="xml"><pivot string="Company-currency estimate analysis"><field name="state" type="row"/><field name="partner_id" type="col"/><field name="cost_amount" type="measure"/><field name="sell_amount" type="measure"/><field name="margin_amount" type="measure"/></pivot></field></record>
    <record id="view_estimate_graph" model="ir.ui.view"><field name="name">jakh.estimate.graph</field><field name="model">jakh.estimate</field><field name="arch" type="xml"><graph string="Company-currency estimate analysis" type="bar"><field name="state"/><field name="sell_amount" type="measure"/></graph></field></record>
    <record id="view_version_list" model="ir.ui.view"><field name="name">jakh.estimate.version.list</field><field name="model">jakh.estimate.version</field><field name="arch" type="xml"><list create="0" edit="0" delete="0"><field name="estimate_id"/><field name="number"/><field name="name"/><field name="created_by_id"/><field name="create_date"/><field name="added_count"/><field name="removed_count"/><field name="modified_count"/><field name="currency_id" groups="jakh_core.group_financial"/><field name="cost_amount" groups="jakh_core.group_financial"/><field name="sell_amount" groups="jakh_core.group_financial"/></list></field></record>
    <record id="view_version_form" model="ir.ui.view"><field name="name">jakh.estimate.version.form</field><field name="model">jakh.estimate.version</field><field name="arch" type="xml"><form create="0" edit="0" delete="0"><sheet><h1><field name="name"/></h1><group><group><field name="estimate_id"/><field name="number"/><field name="created_by_id"/><field name="create_date"/></group><group><field name="added_count"/><field name="removed_count"/><field name="modified_count"/><field name="currency_id" groups="jakh_core.group_financial"/><field name="cost_amount" groups="jakh_core.group_financial"/><field name="sell_amount" groups="jakh_core.group_financial"/></group></group><notebook groups="jakh_core.group_financial"><page string="Changes from preceding version"><field name="comparison_text" nolabel="1"/></page><page string="Exact approved basis"><field name="snapshot_text" nolabel="1"/></page></notebook></sheet></form></field></record>
    <record id="action_estimate" model="ir.actions.act_window"><field name="name">BOQ estimates</field><field name="res_model">jakh.estimate</field><field name="view_mode">list,kanban,form,activity</field><field name="search_view_id" ref="view_estimate_search"/><field name="help" type="html"><p class="o_view_nocontent_smiling_face">Prepare a controlled construction estimate</p><p>Study quantities, resources and building differences; approve a version before creating a quotation and project.</p></field></record>
    <record id="action_estimate_versions" model="ir.actions.act_window"><field name="name">Study versions</field><field name="res_model">jakh.estimate.version</field><field name="view_mode">list,form</field></record>
    <record id="action_estimate_analysis" model="ir.actions.act_window"><field name="name">Estimate analysis</field><field name="res_model">jakh.estimate</field><field name="view_mode">pivot,graph,list,form</field><field name="search_view_id" ref="view_estimate_search"/></record>
    <record id="action_open_estimate_analysis" model="ir.actions.server"><field name="name">Company-currency estimate analysis</field><field name="model_id" ref="model_jakh_estimate"/><field name="state">code</field><field name="code">action = env['jakh.estimate'].action_analysis()</field></record>
    <menuitem id="menu_estimates" name="Tender &amp; BOQ" parent="jakh_core.menu_construction" sequence="20" groups="jakh_core.group_financial,jakh_core.group_technical,jakh_core.group_quality"/>
    <menuitem id="menu_boq_estimates" name="BOQ estimates" parent="menu_estimates" action="action_estimate" sequence="10"/>
    <menuitem id="menu_estimate_versions" name="Study versions" parent="menu_estimates" action="action_estimate_versions" sequence="20"/>
    <menuitem id="menu_estimate_analysis" name="Estimate analysis" parent="menu_estimates" action="action_open_estimate_analysis" sequence="30" groups="jakh_core.group_financial"/>
</odoo>
