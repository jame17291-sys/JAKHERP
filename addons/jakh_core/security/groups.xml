<odoo>
  <record id="privilege_construction" model="res.groups.privilege"><field name="name">JAKH Construction</field><field name="category_id" ref="base.module_category_services"/></record>
  <record id="group_financial" model="res.groups"><field name="name">JAKH Financial Data</field><field name="implied_ids" eval="[(4, ref('base.group_user'))]"/></record>
  <record id="group_technical" model="res.groups"><field name="name">Technical Office — No Prices</field><field name="privilege_id" ref="privilege_construction"/><field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('project.group_project_user'))]"/></record>
  <record id="group_quality" model="res.groups"><field name="name">Quality / HSE</field><field name="privilege_id" ref="privilege_construction"/><field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('project.group_project_user'))]"/></record>
  <record id="group_estimator" model="res.groups"><field name="name">Estimator</field><field name="privilege_id" ref="privilege_construction"/><field name="implied_ids" eval="[(4, ref('group_financial')), (4, ref('sales_team.group_sale_salesman')), (4, ref('project.group_project_user'))]"/></record>
  <record id="group_project_manager" model="res.groups"><field name="name">Project Manager</field><field name="privilege_id" ref="privilege_construction"/><field name="implied_ids" eval="[(4, ref('group_financial')), (4, ref('project.group_project_manager'))]"/></record>
  <record id="group_procurement" model="res.groups"><field name="name">Procurement</field><field name="privilege_id" ref="privilege_construction"/><field name="implied_ids" eval="[(4, ref('group_financial')), (4, ref('purchase.group_purchase_user')), (4, ref('stock.group_stock_user'))]"/></record>
  <record id="group_finance" model="res.groups"><field name="name">Finance</field><field name="privilege_id" ref="privilege_construction"/><field name="implied_ids" eval="[(4, ref('group_financial')), (4, ref('account.group_account_user'))]"/></record>
  <record id="group_manager" model="res.groups"><field name="name">Construction Director</field><field name="privilege_id" ref="privilege_construction"/><field name="implied_ids" eval="[(4, ref('group_estimator')), (4, ref('group_project_manager')), (4, ref('group_procurement')), (4, ref('group_finance')), (4, ref('group_quality')), (4, ref('sales_team.group_sale_manager')), (4, ref('purchase.group_purchase_manager')), (4, ref('stock.group_stock_manager')), (4, ref('account.group_account_manager'))]"/></record>
  <record id="group_platform_owner" model="res.groups"><field name="name">Platform Owner</field><field name="implied_ids" eval="[(4, ref('group_manager')), (4, ref('base.group_system'))]"/><field name="comment">Assigned only through verified platform provisioning; grants full customer application administration, not operating-system credentials.</field></record>
</odoo>
