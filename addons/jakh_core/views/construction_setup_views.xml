<odoo>
  <record id="project_setup_form" model="ir.ui.view"><field name="name">jakh.project.accounting.setup</field><field name="model">project.project</field><field name="inherit_id" ref="project.edit_project"/><field name="arch" type="xml"><xpath expr="//sheet" position="inside"><group string="Construction setup" groups="jakh_core.group_manager"><button name="action_jakh_prepare_cost_centre" string="Prepare accounting cost centre" type="object"/><field name="account_id"/><field name="jakh_location_ids"><list editable="bottom"><field name="code"/><field name="name"/><field name="kind"/><field name="parent_id" domain="[('project_id','=',parent.id)]"/></list></field></group></xpath></field></record>
  <record id="location_list" model="ir.ui.view"><field name="name">jakh.project.location.list</field><field name="model">jakh.project.location</field><field name="arch" type="xml"><list><field name="code"/><field name="name"/><field name="project_id"/><field name="kind"/><field name="parent_id"/><field name="company_id"/></list></field></record>
  <record id="location_form" model="ir.ui.view"><field name="name">jakh.project.location.form</field><field name="model">jakh.project.location</field><field name="arch" type="xml"><form><sheet><group><field name="code"/><field name="name"/><field name="project_id"/><field name="kind"/><field name="parent_id" domain="[('project_id','=',project_id)]"/><field name="company_id"/><field name="active"/></group></sheet><chatter/></form></field></record>
  <record id="action_locations" model="ir.actions.act_window"><field name="name">Buildings, floors &amp; zones</field><field name="res_model">jakh.project.location</field><field name="view_mode">list,form</field></record>
  <record id="discipline_list" model="ir.ui.view"><field name="name">jakh.discipline.list</field><field name="model">jakh.discipline</field><field name="arch" type="xml"><list editable="bottom"><field name="code"/><field name="name"/><field name="company_id"/><field name="active"/></list></field></record>
  <record id="action_disciplines" model="ir.actions.act_window"><field name="name">Construction disciplines</field><field name="res_model">jakh.discipline</field><field name="view_mode">list,form</field></record>
  <menuitem id="menu_locations" name="Buildings, floors &amp; zones" parent="jakh_core.menu_administration" action="action_locations" sequence="12"/>
  <menuitem id="menu_disciplines" name="Construction disciplines" parent="jakh_core.menu_administration" action="action_disciplines" sequence="13"/>
</odoo>
