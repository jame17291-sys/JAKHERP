<odoo>
  <record id="action_dashboard" model="ir.actions.client"><field name="name">JAKH Dashboard</field><field name="tag">jakh_dashboard</field></record>
  <record id="action_projects" model="ir.actions.act_window"><field name="name">Projects</field><field name="res_model">project.project</field><field name="view_mode">kanban,list,form</field><field name="domain">[('active', '=', True)]</field></record>
  <record id="action_crm" model="ir.actions.act_window"><field name="name">JAKH CRM</field><field name="res_model">crm.lead</field><field name="view_mode">kanban,list,form,calendar,pivot,graph</field><field name="domain">[('type', '=', 'opportunity')]</field><field name="context">{'default_type': 'opportunity'}</field></record>
  <record id="action_purchase_orders" model="ir.actions.act_window"><field name="name">Purchase Orders</field><field name="res_model">purchase.order</field><field name="view_mode">list,form,pivot,graph</field></record>
  <record id="action_stock" model="ir.actions.act_window"><field name="name">Receipts &amp; Stores</field><field name="res_model">stock.picking</field><field name="view_mode">list,kanban,form,calendar</field></record>
  <record id="action_journals" model="ir.actions.act_window"><field name="name">Posted Journal Entries</field><field name="res_model">account.move</field><field name="view_mode">list,form</field><field name="domain">[('state', '=', 'posted')]</field></record>
  <record id="action_my_activities" model="ir.actions.act_window"><field name="name">My Activities &amp; Approvals</field><field name="res_model">mail.activity</field><field name="view_mode">list,form</field><field name="domain">[('user_id', '=', uid)]</field></record>
  <record id="view_cost_code_list" model="ir.ui.view"><field name="name">jakh.cost.code.list</field><field name="model">jakh.cost.code</field><field name="arch" type="xml"><list><field name="code"/><field name="name"/><field name="resource_type"/><field name="parent_id" optional="hide"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
  <record id="view_cost_code_form" model="ir.ui.view"><field name="name">jakh.cost.code.form</field><field name="model">jakh.cost.code</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="code"/><field name="company_id"/><field name="resource_type"/><field name="parent_id"/><field name="active"/></group></sheet><chatter/></form></field></record>
  <record id="action_cost_codes" model="ir.actions.act_window"><field name="name">Cost-Code Master</field><field name="res_model">jakh.cost.code</field><field name="view_mode">list,form</field></record>
  <record id="view_wbs_list" model="ir.ui.view"><field name="name">jakh.wbs.list</field><field name="model">jakh.wbs</field><field name="arch" type="xml"><list><field name="code"/><field name="name"/><field name="project_id"/><field name="cost_code_id" optional="show"/><field name="budget_amount" groups="jakh_core.group_financial" sum="Budget"/><field name="currency_id" groups="jakh_core.group_financial"/><field name="state" widget="badge"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
  <record id="view_wbs_form" model="ir.ui.view"><field name="name">jakh.wbs.form</field><field name="model">jakh.wbs</field><field name="arch" type="xml"><form><header><button name="action_release" string="Release WBS" type="object" class="btn-primary" groups="jakh_core.group_manager" invisible="state != 'draft'"/><field name="state" widget="statusbar"/></header><sheet><group><field name="name"/><field name="code" readonly="state != 'draft'"/><field name="project_id" readonly="state != 'draft'"/><field name="company_id"/><field name="parent_id" readonly="state != 'draft'"/><field name="cost_code_id" readonly="state != 'draft'"/></group><group groups="jakh_core.group_financial"><field name="currency_id"/><field name="budget_amount" readonly="state != 'draft'"/><field name="forecast_amount"/></group></sheet><chatter/></form></field></record>
  <record id="view_wbs_search" model="ir.ui.view"><field name="name">jakh.wbs.search</field><field name="model">jakh.wbs</field><field name="arch" type="xml"><search><field name="name"/><field name="code"/><field name="project_id"/><field name="cost_code_id"/><filter name="released" string="Released" domain="[('state', '=', 'released')]"/><filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/><filter name="group_cost" string="Cost Code" context="{'group_by': 'cost_code_id'}"/></search></field></record>
  <record id="action_wbs" model="ir.actions.act_window"><field name="name">WBS &amp; Budgets</field><field name="res_model">jakh.wbs</field><field name="view_mode">list,form</field></record>
  <record id="view_audit_list" model="ir.ui.view"><field name="name">jakh.audit.event.list</field><field name="model">jakh.audit.event</field><field name="arch" type="xml"><list create="0" edit="0" delete="0"><field name="create_date"/><field name="actor_id"/><field name="operation"/><field name="resource_model"/><field name="resource_id"/><field name="company_id"/></list></field></record>
  <record id="action_audit" model="ir.actions.act_window"><field name="name">Business Audit</field><field name="res_model">jakh.audit.event</field><field name="view_mode">list,form</field></record>
  <menuitem id="menu_construction" name="JAKH ERP" sequence="10" action="action_dashboard"/>
  <menuitem id="menu_assurance" name="Quality, HSE &amp; Specifications" parent="menu_construction" sequence="70"/>
  <record id="menu_assurance" model="ir.ui.menu"><field name="action" eval="False"/></record>
  <menuitem id="menu_dashboard" name="Dashboard" parent="menu_construction" action="action_dashboard" sequence="1"/>
  <menuitem id="menu_crm" name="CRM" parent="menu_construction" action="action_crm" sequence="10" groups="sales_team.group_sale_salesman"/>
  <menuitem id="menu_projects" name="Projects" parent="menu_construction" action="action_projects" sequence="30"/>
  <menuitem id="menu_wbs" name="WBS &amp; Budgets" parent="menu_construction" action="action_wbs" sequence="35"/>
  <menuitem id="menu_purchase" name="Purchasing" parent="menu_construction" action="action_purchase_orders" sequence="50" groups="jakh_core.group_procurement"/>
  <menuitem id="menu_stores" name="Stores &amp; Receipts" parent="menu_construction" action="action_stock" sequence="60" groups="stock.group_stock_user"/>
  <menuitem id="menu_reports" name="Reports" parent="menu_construction" sequence="3"/>
  <menuitem id="menu_activities" name="My Approvals &amp; Activities" parent="menu_construction" action="action_my_activities" sequence="4"/>
  <menuitem id="menu_administration" name="Administration" parent="menu_construction" sequence="90" groups="jakh_core.group_manager"/>
  <menuitem id="menu_cost_codes" name="Cost Codes" parent="menu_administration" action="action_cost_codes" sequence="10"/>
  <menuitem id="menu_audit" name="Business Audit" parent="menu_administration" action="action_audit" sequence="20"/>
  <menuitem id="menu_journals" name="Posted Ledger" parent="menu_reports" action="action_journals" sequence="30" groups="jakh_core.group_finance"/>
  <function model="ir.ui.menu" name="_jakh_configure_module_menus"/>
</odoo>
