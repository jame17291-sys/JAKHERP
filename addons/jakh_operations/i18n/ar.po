#. module: jakh_operations
#. odoo-python
#: code:addons/jakh_operations/models/project_control.py:0
msgid ""
"Company-currency project control as of the selected date. Budget revisions, "
"commitments, approved variations and forecasts are controlled operational "
"facts; actual costs and billing are created only from posted native "
"accounting documents or accepted verified labour/plant feeds. Received cost "
"exposure, including approved subcontract service entries, is shown "
"separately and is not added to actual cost. CPI equals earned value divided "
"by actual cost; SPI equals earned value divided by planned value. Forecast "
"final cost is the latest approved forecast, or the revised budget where no "
"forecast is approved."
msgstr ""
"رقابة المشروع بعملة الشركة حتى التاريخ المحدد. تعديلات الميزانية والالتزامات"
" والتغييرات والتنبؤات المعتمدة هي وقائع تشغيلية خاضعة للرقابة؛ ولا تنشأ "
"التكاليف الفعلية والفوترة إلا من مستندات محاسبية أصلية مرحلة أو تغذيات "
"عمالة/معدات موثقة ومقبولة. يظهر تعرض تكلفة الاستلام، بما فيه إدخالات خدمة "
"المقاولة الفرعية المعتمدة، منفصلاً ولا يضاف إلى التكلفة الفعلية. يساوي CPI "
"القيمة المكتسبة مقسومة على التكلفة الفعلية، ويساوي SPI القيمة المكتسبة "
"مقسومة على القيمة المخططة. التكلفة النهائية المتوقعة هي أحدث تنبؤ معتمد أو "
"الميزانية المعدلة عند عدم وجود تنبؤ معتمد."

