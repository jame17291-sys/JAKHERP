<odoo>
  <record id="site_resource_list" model="ir.ui.view"><field name="name">jakh.site.resource.list</field><field name="model">jakh.site.resource</field><field name="arch" type="xml"><list><field name="name"/><field name="kind"/><field name="source_reference"/><field name="company_id"/><field name="active"/></list></field></record>
