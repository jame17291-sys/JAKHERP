<odoo>
  <record id="financial_report_form" model="ir.ui.view"><field name="name">jakh.financial.report.form</field><field name="model">jakh.financial.report</field><field name="arch" type="xml"><form>
    <header><button name="action_generate" type="object" string="Generate from posted ledger" class="btn-primary"/><button name="action_pivot" type="object" string="Pivot / export"/></header><sheet>
      <group><field name="report_type"/><field name="company_id"/><field name="currency_id"/><field name="date_from" invisible="report_type in ('balance_sheet','receivable_aging','payable_aging')"/><field name="date_to"/></group>
      <field name="scope_note" readonly="1"/>
      <field name="line_ids" readonly="1"><list create="false" edit="false" delete="false"><field name="account_id"/><field name="partner_id" optional="show"/><field name="date" optional="show"/><field name="due_date" optional="hide"/><field name="label"/><field name="bucket" optional="show"/><field name="opening" sum="Opening"/><field name="debit" sum="Debit"/><field name="credit" sum="Credit"/><field name="balance" sum="Signed balance"/><field name="currency_id" column_invisible="True"/><field name="move_id" optional="show"/><button name="action_drill" type="object" string="Journal detail"/></list></field>
    </sheet></form></field></record>
  <record id="financial_report_line_list" model="ir.ui.view"><field name="name">jakh.financial.report.line.list</field><field name="model">jakh.financial.report.line</field><field name="arch" type="xml"><list create="false" edit="false" delete="false"><field name="account_id"/><field name="partner_id"/><field name="date"/><field name="label"/><field name="bucket"/><field name="opening" sum="Opening"/><field name="debit" sum="Debit"/><field name="credit" sum="Credit"/><field name="balance" sum="Signed balance"/><field name="currency_id" column_invisible="True"/><field name="move_id"/><button name="action_drill" type="object" string="Journal detail"/></list></field></record>
  <record id="financial_report_line_pivot" model="ir.ui.view"><field name="name">jakh.financial.report.line.pivot</field><field name="model">jakh.financial.report.line</field><field name="arch" type="xml"><pivot><field name="account_id" type="row"/><field name="bucket" type="col"/><field name="opening" type="measure"/><field name="debit" type="measure"/><field name="credit" type="measure"/><field name="balance" type="measure"/></pivot></field></record>
  <record id="action_financial_report" model="ir.actions.act_window"><field name="name">Posted ledger reports</field><field name="res_model">jakh.financial.report</field><field name="view_mode">form</field><field name="target">current</field></record>
  <menuitem id="menu_financial_report" name="Ledger, trial balance &amp; aging" parent="jakh_core.menu_reports" action="action_financial_report" groups="jakh_core.group_manager,jakh_core.group_finance" sequence="10"/>
</odoo>
