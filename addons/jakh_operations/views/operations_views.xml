<odoo>
  <record id="request_list" model="ir.ui.view"><field name="name">jakh.purchase.request.list</field><field name="model">jakh.purchase.request</field><field name="arch" type="xml"><list><field name="name"/><field name="project_id"/><field name="wbs_id"/><field name="required_date"/><field name="state"/><field name="reserved_amount" groups="jakh_core.group_financial"/><field name="currency_id" column_invisible="True"/></list></field></record>
  <record id="request_form" model="ir.ui.view"><field name="name">jakh.purchase.request.form</field><field name="model">jakh.purchase.request</field><field name="arch" type="xml">
    <form><header>
      <button name="action_submit" type="object" string="Submit quantities" class="btn-primary" invisible="state != 'draft'"/>
      <button name="action_approve" type="object" string="Approve budget reservation" class="btn-primary" groups="jakh_core.group_manager,jakh_core.group_project_manager,jakh_core.group_finance" invisible="state != 'submitted'"/>
      <button name="action_release" type="object" string="Create / open purchase order" groups="jakh_core.group_manager,jakh_core.group_procurement" invisible="state not in ('approved', 'released')"/>
      <button name="action_cancel" type="object" string="Cancel reservation" groups="jakh_core.group_manager,jakh_core.group_project_manager,jakh_core.group_finance" invisible="state == 'cancelled'"/>
      <field name="state" widget="statusbar"/>
    </header><sheet>
      <div class="alert alert-info" role="status">Approved company-currency, tax-exclusive prices reserve the released WBS budget. Reference the approved planning demand; native PO receipts and bills retain their standard workflow.</div>
      <group><field name="name" readonly="state not in ('draft','submitted')"/><field name="project_id" readonly="state != 'draft'"/><field name="wbs_id" domain="[('project_id','=',project_id)]" readonly="state != 'draft'"/><field name="company_id"/><field name="currency_id" invisible="1"/><field name="required_date" readonly="state not in ('draft','submitted')"/><field name="material_plan_reference" readonly="state not in ('draft','submitted')"/><field name="attachment_ids" widget="many2many_binary" readonly="state not in ('draft','submitted')"/></group>
      <notebook><page string="Requested quantities"><field name="line_ids" readonly="state not in ('draft','submitted')"><list editable="bottom"><field name="name"/><field name="product_id"/><field name="uom_id"/><field name="quantity"/></list></field></page>
      <page string="Restricted pricing" groups="jakh_core.group_financial"><group><field name="supplier_id" readonly="state not in ('draft','submitted')"/><field name="reserved_amount"/><field name="purchase_order_id"/><field name="approved_by"/><field name="approved_at"/></group><field name="cost_ids" readonly="state not in ('draft','submitted')"><list editable="bottom"><field name="line_id" domain="[('request_id','=',parent.id)]"/><field name="unit_price"/><field name="tax_ids" widget="many2many_tags"/></list></field></page></notebook>
    </sheet><chatter/></form>
  </field></record>
  <record id="action_purchase_requests" model="ir.actions.act_window"><field name="name">Project requisitions</field><field name="res_model">jakh.purchase.request</field><field name="view_mode">list,form</field></record>
  <menuitem id="menu_purchase_requests" name="Project requisitions" parent="jakh_core.menu_construction" action="action_purchase_requests" sequence="30"/>

  <record id="contract_list" model="ir.ui.view"><field name="name">jakh.project.contract.list</field><field name="model">jakh.project.contract</field><field name="arch" type="xml"><list><field name="name"/><field name="project_id"/><field name="partner_id"/><field name="sale_order_id"/><field name="state"/><field name="company_id"/></list></field></record>
  <record id="contract_form" model="ir.ui.view"><field name="name">jakh.project.contract.form</field><field name="model">jakh.project.contract</field><field name="arch" type="xml"><form>
    <header><button name="action_activate" type="object" string="Approve finance configuration" class="btn-primary" groups="jakh_core.group_manager,jakh_core.group_finance" invisible="state != 'draft'"/><field name="state" widget="statusbar"/></header><sheet>
      <div class="alert alert-info" role="status">This release measures an immutable customer BOQ in company currency. Finance explicitly configures control accounts, tax treatment and deduction caps. The advance ceiling does not assert that cash has been received.</div>
      <group><field name="name" readonly="state != 'draft'"/><field name="project_id" readonly="state != 'draft'"/><field name="partner_id" readonly="state != 'draft'"/><field name="sale_order_id" readonly="state != 'draft'"/><field name="company_id"/><field name="currency_id"/><field name="finance_approved_by"/></group>
      <notebook><page string="Contract BOQ"><field name="line_ids" readonly="state != 'draft'"><list editable="bottom"><field name="code"/><field name="name"/><field name="wbs_id" domain="[('project_id','=',parent.project_id)]"/><field name="uom_id"/><field name="quantity"/><field name="unit_price" groups="jakh_core.group_financial"/></list></field></page>
      <page string="Finance policy" groups="jakh_core.group_financial"><group><group><field name="journal_id" readonly="state != 'draft'"/><field name="income_account_id" readonly="state != 'draft'"/><field name="tax_ids" widget="many2many_tags" readonly="state != 'draft'"/><field name="retention_percent" readonly="state != 'draft'"/><field name="retention_cap" readonly="state != 'draft'"/><field name="retention_account_id" readonly="state != 'draft'"/><field name="retention_tax_ids" widget="many2many_tags" readonly="state != 'draft'"/></group><group><field name="recovery_percent" readonly="state != 'draft'"/><field name="advance_cap" readonly="state != 'draft'"/><field name="advance_account_id" readonly="state != 'draft'"/><field name="recovery_tax_ids" widget="many2many_tags" readonly="state != 'draft'"/><field name="deduction_account_id" readonly="state != 'draft'"/><field name="deduction_tax_ids" widget="many2many_tags" readonly="state != 'draft'"/></group></group></page></notebook>
    </sheet><chatter/></form></field></record>
  <record id="action_project_contracts" model="ir.actions.act_window"><field name="name">Project contracts</field><field name="res_model">jakh.project.contract</field><field name="view_mode">list,form</field></record>
  <menuitem id="menu_project_contracts" name="Contracts &amp; measured BOQ" parent="jakh_core.menu_construction" action="action_project_contracts" sequence="40"/>

  <record id="certificate_list" model="ir.ui.view"><field name="name">jakh.payment.certificate.list</field><field name="model">jakh.payment.certificate</field><field name="arch" type="xml"><list><field name="name"/><field name="contract_id"/><field name="date"/><field name="state"/><field name="period_gross" groups="jakh_core.group_financial"/><field name="net_before_tax" groups="jakh_core.group_financial"/><field name="currency_id" column_invisible="True"/></list></field></record>
  <record id="certificate_form" model="ir.ui.view"><field name="name">jakh.payment.certificate.form</field><field name="model">jakh.payment.certificate</field><field name="arch" type="xml"><form>
    <header><button name="action_prepare_lines" type="object" string="Prepare cumulative BOQ" invisible="state != 'draft' or line_ids"/><button name="action_submit" type="object" string="Submit measurement" class="btn-primary" invisible="state != 'draft'"/><button name="action_approve" type="object" string="Approve certificate" groups="jakh_core.group_manager,jakh_core.group_finance" invisible="state != 'submitted'"/><button name="action_create_invoice" type="object" string="Create / open draft invoice" groups="jakh_core.group_manager,jakh_core.group_finance" invisible="state not in ('approved','invoiced')"/><field name="state" widget="statusbar"/></header><sheet>
      <div class="alert alert-info" role="status">Enter every BOQ item's cumulative installed quantity. Previous gross and quantities come from prior approved certificates. Draft invoices are posted only through native accounting permissions and controls.</div>
      <group><field name="name" readonly="state != 'draft'"/><field name="contract_id" readonly="state != 'draft'"/><field name="date" readonly="state != 'draft'"/><field name="company_id"/><field name="currency_id" invisible="1"/><field name="approved_by"/><field name="approval_sequence"/></group>
      <field name="line_ids" readonly="state != 'draft'"><list editable="bottom"><field name="contract_line_id" domain="[('contract_id','=',parent.contract_id)]"/><field name="cumulative_quantity"/></list></field>
      <group groups="jakh_core.group_financial"><group><field name="cumulative_gross"/><field name="previous_gross"/><field name="period_gross"/><field name="retention_amount"/><field name="recovery_amount"/></group><group><field name="other_deductions" readonly="state != 'draft'"/><field name="deduction_reason" readonly="state != 'draft'"/><field name="net_before_tax"/><field name="invoice_id"/></group></group>
    </sheet><chatter/></form></field></record>
  <record id="action_payment_certificates" model="ir.actions.act_window"><field name="name">Measured payment certificates</field><field name="res_model">jakh.payment.certificate</field><field name="view_mode">list,form</field></record>
  <menuitem id="menu_payment_certificates" name="Payment certificates" parent="jakh_core.menu_construction" action="action_payment_certificates" sequence="50"/>
</odoo>
