<odoo>
  <record id="request_boq_dimensions" model="ir.ui.view"><field name="name">jakh.request.boq.dimensions</field><field name="model">jakh.purchase.request</field><field name="inherit_id" ref="jakh_operations.request_form"/><field name="arch" type="xml"><xpath expr="//field[@name='line_ids']/list/field[@name='name']" position="after"><field name="contract_line_id" domain="[('wbs_id','=',parent.wbs_id)]" optional="show"/><field name="location_id" domain="[('project_id','=',parent.project_id)]" optional="show"/><field name="discipline_id" optional="hide"/></xpath></field></record>
  <record id="contract_boq_dimensions" model="ir.ui.view"><field name="name">jakh.contract.boq.dimensions</field><field name="model">jakh.project.contract</field><field name="inherit_id" ref="jakh_operations.contract_form"/><field name="arch" type="xml"><xpath expr="//field[@name='line_ids']/list/field[@name='wbs_id']" position="after"><field name="location_id" domain="[('project_id','=',parent.project_id)]" optional="show"/><field name="discipline_id" optional="show"/></xpath></field></record>
  <record id="service_boq_dimensions" model="ir.ui.view"><field name="name">jakh.service.boq.dimensions</field><field name="model">jakh.subcontract.service.entry</field><field name="inherit_id" ref="jakh_operations.ses_form"/><field name="arch" type="xml"><xpath expr="//field[@name='wbs_id']" position="after"><field name="contract_line_id"/><field name="location_id"/><field name="discipline_id"/></xpath></field></record>
  <record id="actual_cost_boq_dimensions" model="ir.ui.view"><field name="name">jakh.actual.cost.boq.dimensions</field><field name="model">jakh.project.actual.feed</field><field name="inherit_id" ref="jakh_operations.actual_feed_form"/><field name="arch" type="xml"><xpath expr="//field[@name='wbs_id']" position="after"><field name="contract_line_id" domain="[('wbs_id','=',wbs_id)]" readonly="state != 'draft'"/><field name="location_id" domain="[('project_id','=',project_id)]" readonly="state != 'draft'"/><field name="discipline_id" readonly="state != 'draft'"/></xpath></field></record>
  <record id="schedule_boq_dimensions" model="ir.ui.view"><field name="name">jakh.schedule.boq.dimensions</field><field name="model">jakh.project.schedule.progress</field><field name="inherit_id" ref="jakh_operations.schedule_progress_form"/><field name="arch" type="xml"><xpath expr="//field[@name='wbs_id']" position="after"><field name="contract_line_id" domain="[('wbs_id','=',wbs_id)]" readonly="state != 'draft'"/><field name="location_id" domain="[('project_id','=',project_id)]" readonly="state != 'draft'"/><field name="discipline_id" readonly="state != 'draft'"/></xpath></field></record>
  <record id="resource_boq_dimensions" model="ir.ui.view"><field name="name">jakh.resource.boq.dimensions</field><field name="model">jakh.resource.assignment</field><field name="inherit_id" ref="jakh_operations.resource_assignment_form"/><field name="arch" type="xml"><xpath expr="//field[@name='wbs_id']" position="after"><field name="contract_line_id" domain="[('wbs_id','=',wbs_id)]" readonly="state != 'draft'"/><field name="location_id" domain="[('project_id','=',project_id)]" readonly="state != 'draft'"/><field name="discipline_id" readonly="state != 'draft'"/></xpath></field></record>
</odoo>
