<odoo>
  <record id="integration_binding_list" model="ir.ui.view"><field name="name">jakh.integration.binding.list</field><field name="model">jakh.integration.binding</field><field name="arch" type="xml"><list><field name="name"/><field name="kind"/><field name="source_project_ref"/><field name="source_wbs_ref"/><field name="project_id"/><field name="wbs_id"/><field name="location_id"/><field name="state"/></list></field></record>
  <record id="integration_binding_form" model="ir.ui.view"><field name="name">jakh.integration.binding.form</field><field name="model">jakh.integration.binding</field><field name="arch" type="xml"><form><header><button name="action_approve" string="Approve source mapping" type="object" invisible="state != 'draft'"/><button name="action_retire" string="Retire source mapping" type="object" invisible="state != 'approved'"/><field name="state" widget="statusbar"/></header><sheet><group><field name="name" readonly="state != 'draft'"/><field name="kind" readonly="state != 'draft'"/><field name="company_id" readonly="state != 'draft'"/><field name="source_project_ref" readonly="state != 'draft'"/><field name="source_wbs_ref" readonly="state != 'draft'"/><field name="project_id" readonly="state != 'draft'"/><field name="wbs_id" domain="[('project_id','=',project_id)]" readonly="state != 'draft'"/><field name="contract_line_id" domain="[('wbs_id','=',wbs_id)]" readonly="state != 'draft'"/><field name="location_id" domain="[('project_id','=',project_id)]" readonly="state != 'draft'"/><field name="discipline_id" readonly="state != 'draft'"/><field name="approved_by"/></group><div class="alert alert-info">P6 remains the schedule master and Jisr remains the payroll master. Source messages prepare reviewed business evidence; they do not approve costs, post journals or establish a live vendor connection.</div></sheet><chatter/></form></field></record>
  <record id="action_integration_bindings" model="ir.actions.act_window"><field name="name">P6 / Jisr source mappings</field><field name="res_model">jakh.integration.binding</field><field name="view_mode">list,form</field></record>
  <menuitem id="menu_integration_bindings" name="P6 / Jisr source mappings" parent="jakh_core.menu_administration" action="action_integration_bindings" sequence="31" groups="jakh_core.group_manager,jakh_core.group_project_manager,jakh_core.group_finance"/>
  <record id="integration_binding_revision_form" model="ir.ui.view"><field name="name">jakh.integration.binding.revision.form</field><field name="model">jakh.integration.binding</field><field name="inherit_id" ref="integration_binding_form"/><field name="arch" type="xml"><xpath expr="//header" position="inside"><button name="action_new_revision" string="Create revised mapping" type="object" invisible="state != 'retired'" groups="jakh_core.group_manager,jakh_core.group_finance"/></xpath><xpath expr="//field[@name='approved_by']" position="after"><field name="revision"/></xpath></field></record>
</odoo>
