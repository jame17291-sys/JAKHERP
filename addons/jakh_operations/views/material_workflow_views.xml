<odoo>
  <record id="material_request_list" model="ir.ui.view"><field name="name">jakh.material.request.list</field><field name="model">jakh.material.request</field><field name="arch" type="xml"><list><field name="name"/><field name="project_id"/><field name="contract_line_id"/><field name="location_id"/><field name="product_id"/><field name="quantity"/><field name="issued_quantity"/><field name="shortage_quantity"/><field name="required_date"/><field name="state"/></list></field></record>
  <record id="material_request_form" model="ir.ui.view"><field name="name">jakh.material.request.form</field><field name="model">jakh.material.request</field><field name="arch" type="xml"><form><header><button name="action_submit" string="Submit demand" type="object" invisible="state != 'draft'"/><button name="action_approve" string="Approve demand" type="object" invisible="state != 'submitted'" groups="jakh_core.group_manager,jakh_core.group_project_manager"/><button name="action_prepare_shortage" string="Prepare shortage requisition" type="object" invisible="state != 'approved'"/><button name="action_prepare_issue" string="Reserve / open stock issue" type="object" invisible="state != 'approved'"/><button name="action_cancel" string="Cancel demand" type="object" invisible="state in ('done','cancelled')"/><field name="state" widget="statusbar"/></header><sheet><group><field name="name" readonly="state != 'draft'"/><field name="project_id" readonly="state != 'draft'"/><field name="company_id"/><field name="wbs_id" domain="[('project_id','=',project_id)]" readonly="state != 'draft'"/><field name="contract_line_id" domain="[('wbs_id','=',wbs_id)]" readonly="state != 'draft'"/><field name="location_id" domain="[('project_id','=',project_id)]" readonly="state != 'draft'"/><field name="discipline_id" readonly="state != 'draft'"/><field name="product_id" domain="[('is_storable','=',True)]" readonly="state != 'draft'"/><field name="uom_id"/><field name="quantity" readonly="state != 'draft'"/><field name="required_date" readonly="state != 'draft'"/><field name="source_location_id" domain="[('usage','=','internal'),('company_id','=',company_id)]" readonly="state != 'draft'"/><field name="consumption_location_id" domain="[('usage','=','inventory'),('company_id','=',company_id)]" readonly="state != 'draft'"/><field name="approved_by"/></group><field name="reason" readonly="state != 'draft'"/><group string="Availability and partial issue"><field name="available_quantity"/><field name="issued_quantity"/><field name="remaining_quantity"/><field name="shortage_quantity"/><field name="issue_quantity" readonly="state not in ('draft','approved')"/><field name="request_id"/></group><field name="picking_ids" readonly="1"/><div class="alert alert-info">Stocked material is capitalised at supplier billing and charged to job cost once through a posted native site-consumption journal. Finance must configure valuation before issue.</div></sheet><chatter/></form></field></record>
  <record id="material_request_search" model="ir.ui.view"><field name="name">jakh.material.request.search</field><field name="model">jakh.material.request</field><field name="arch" type="xml"><search><field name="name"/><field name="project_id"/><field name="location_id"/><field name="contract_line_id"/><field name="product_id"/><filter name="open" string="Open demand" domain="[('state','not in',('done','cancelled'))]"/><filter name="by_project" string="Project" context="{'group_by':'project_id'}"/><filter name="by_location" string="Building / floor" context="{'group_by':'location_id'}"/></search></field></record>
  <record id="action_material_requests" model="ir.actions.act_window"><field name="name">Site materials &amp; issues</field><field name="res_model">jakh.material.request</field><field name="view_mode">list,form</field></record>
  <menuitem id="menu_material_requests" name="Site materials &amp; issues" parent="jakh_core.menu_construction" action="action_material_requests" sequence="48" groups="jakh_core.group_manager,jakh_core.group_project_manager,jakh_core.group_procurement"/>
</odoo>
