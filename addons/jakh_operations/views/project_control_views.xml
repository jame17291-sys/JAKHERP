<odoo>
  <record id="variation_list" model="ir.ui.view"><field name="name">jakh.project.variation.list</field><field name="model">jakh.project.variation</field><field name="arch" type="xml"><list><field name="name"/><field name="variation_type"/><field name="effect"/><field name="project_id"/><field name="wbs_id"/><field name="partner_id" optional="show"/><field name="amount" groups="jakh_core.group_financial" sum="Commercial impact"/><field name="currency_id" column_invisible="True"/><field name="date"/><field name="state" widget="badge"/></list></field></record>
  <record id="variation_form" model="ir.ui.view"><field name="name">jakh.project.variation.form</field><field name="model">jakh.project.variation</field><field name="arch" type="xml"><form><header>
    <button name="action_submit" type="object" string="Submit variation" class="btn-primary" invisible="state != 'draft'"/>
    <button name="action_price" type="object" string="Confirm priced impact" groups="jakh_core.group_manager,jakh_core.group_finance" invisible="state != 'submitted'"/>
    <button name="action_approve" type="object" string="Approve commercial impact" class="btn-primary" groups="jakh_core.group_manager,jakh_core.group_finance" invisible="state != 'priced'"/>
    <button name="action_reject" type="object" string="Reject" groups="jakh_core.group_manager,jakh_core.group_finance" invisible="state not in ('submitted','priced')"/>
    <field name="state" widget="statusbar"/>
  </header><sheet>
    <div class="alert alert-info" role="status">An approved owner variation is available to the next cumulative certificate. An approved subcontract variation changes the commercial cost view but does not create a supplier commitment or invoice by itself.</div>
    <group><group><field name="name" readonly="state != 'draft'"/><field name="variation_type" readonly="state != 'draft'"/><field name="effect" readonly="state != 'draft'"/><field name="project_id" readonly="state != 'draft'"/><field name="wbs_id" domain="[('project_id','=',project_id)]" readonly="state != 'draft'"/><field name="contract_id" domain="[('project_id','=',project_id)]" readonly="state != 'draft'"/><field name="partner_id" readonly="state != 'draft'"/></group><group><field name="date" readonly="state != 'draft'"/><field name="company_id"/><field name="currency_id" invisible="1"/><field name="quantity" readonly="state != 'draft'"/><field name="uom_id" readonly="state != 'draft'"/><field name="unit_price" readonly="state != 'draft'" groups="jakh_core.group_financial"/><field name="amount" groups="jakh_core.group_financial"/><field name="priced_by"/><field name="approved_by"/><field name="approved_at"/></group></group>
    <group><field name="description" readonly="state != 'draft'"/></group>
  </sheet><chatter/></form></field></record>
  <record id="variation_search" model="ir.ui.view"><field name="name">jakh.project.variation.search</field><field name="model">jakh.project.variation</field><field name="arch" type="xml"><search><field name="name"/><field name="project_id"/><field name="wbs_id"/><field name="partner_id"/><filter name="pending" string="Awaiting approval" domain="[('state','=','priced')]"/><filter name="owner" string="Owner" domain="[('variation_type','=','owner')]"/><filter name="subcontract" string="Subcontract" domain="[('variation_type','=','subcontract')]"/><filter name="project_group" string="Project" context="{'group_by':'project_id'}"/><filter name="state_group" string="Status" context="{'group_by':'state'}"/></search></field></record>
  <record id="action_variations" model="ir.actions.act_window"><field name="name">Variations</field><field name="res_model">jakh.project.variation</field><field name="view_mode">list,form,pivot,graph</field></record>
  <menuitem id="menu_variations" name="Variations" parent="menu_project_contracts" action="action_variations" sequence="20" groups="jakh_core.group_manager,jakh_core.group_project_manager,jakh_core.group_finance"/>

  <record id="budget_revision_list" model="ir.ui.view"><field name="name">jakh.project.budget.revision.list</field><field name="model">jakh.project.budget.revision</field><field name="arch" type="xml"><list><field name="name"/><field name="project_id"/><field name="wbs_id"/><field name="date"/><field name="proposed_budget" groups="jakh_core.group_financial" sum="Proposed budget"/><field name="approved_delta" groups="jakh_core.group_financial" sum="Approved change"/><field name="currency_id" column_invisible="True"/><field name="state" widget="badge"/></list></field></record>
  <record id="budget_revision_form" model="ir.ui.view"><field name="name">jakh.project.budget.revision.form</field><field name="model">jakh.project.budget.revision</field><field name="arch" type="xml"><form><header>
    <button name="action_submit" type="object" string="Submit revision" class="btn-primary" invisible="state != 'draft'"/>
    <button name="action_approve" type="object" string="Approve budget revision" class="btn-primary" groups="jakh_core.group_manager,jakh_core.group_finance" invisible="state != 'submitted'"/>
    <button name="action_reject" type="object" string="Reject" groups="jakh_core.group_manager,jakh_core.group_finance" invisible="state != 'submitted'"/>
    <field name="state" widget="statusbar"/>
  </header><sheet><div class="alert alert-info" role="status">Approval creates an immutable budget-control fact. It cannot reduce the available budget below approved commitments or posted actual costs.</div><group><group><field name="name" readonly="state != 'draft'"/><field name="wbs_id" readonly="state != 'draft'"/><field name="project_id"/><field name="company_id"/><field name="date" readonly="state != 'draft'"/></group><group groups="jakh_core.group_financial"><field name="currency_id" invisible="1"/><field name="proposed_budget" readonly="state != 'draft'"/><field name="approved_delta"/><field name="approved_by"/><field name="approved_at"/></group></group><group><field name="reason" readonly="state != 'draft'"/></group></sheet><chatter/></form></field></record>
  <record id="action_budget_revisions" model="ir.actions.act_window"><field name="name">Budget revisions</field><field name="res_model">jakh.project.budget.revision</field><field name="view_mode">list,form</field></record>
  <menuitem id="menu_budget_revisions" name="Budget revisions" parent="jakh_core.menu_wbs" action="action_budget_revisions" sequence="20" groups="jakh_core.group_manager,jakh_core.group_project_manager,jakh_core.group_finance"/>

  <record id="forecast_list" model="ir.ui.view"><field name="name">jakh.project.forecast.list</field><field name="model">jakh.project.forecast</field><field name="arch" type="xml"><list><field name="name"/><field name="project_id"/><field name="wbs_id"/><field name="as_of_date"/><field name="forecast_final_cost" groups="jakh_core.group_financial" sum="Forecast final cost"/><field name="currency_id" column_invisible="True"/><field name="state" widget="badge"/></list></field></record>
  <record id="forecast_form" model="ir.ui.view"><field name="name">jakh.project.forecast.form</field><field name="model">jakh.project.forecast</field><field name="arch" type="xml"><form><header>
    <button name="action_submit" type="object" string="Submit forecast" class="btn-primary" invisible="state != 'draft'"/>
    <button name="action_approve" type="object" string="Approve forecast" class="btn-primary" groups="jakh_core.group_manager,jakh_core.group_finance" invisible="state != 'submitted'"/>
    <button name="action_reject" type="object" string="Reject" groups="jakh_core.group_manager,jakh_core.group_finance" invisible="state != 'submitted'"/>
    <field name="state" widget="statusbar"/>
  </header><sheet><div class="alert alert-info" role="status">Each approval records a dated forecast-final-cost fact. The CVR uses the latest approved forecast for each WBS and retains earlier forecasts for audit.</div><group><group><field name="name" readonly="state != 'draft'"/><field name="wbs_id" readonly="state != 'draft'"/><field name="project_id"/><field name="company_id"/><field name="as_of_date" readonly="state != 'draft'"/></group><group groups="jakh_core.group_financial"><field name="currency_id" invisible="1"/><field name="forecast_final_cost" readonly="state != 'draft'"/><field name="approved_by"/><field name="approved_at"/></group></group><group><field name="basis" readonly="state != 'draft'"/></group></sheet><chatter/></form></field></record>
  <record id="action_forecasts" model="ir.actions.act_window"><field name="name">Cost forecasts</field><field name="res_model">jakh.project.forecast</field><field name="view_mode">list,form,pivot,graph</field></record>
  <menuitem id="menu_forecasts" name="Cost forecasts" parent="jakh_core.menu_reports" action="action_forecasts" sequence="20" groups="jakh_core.group_manager,jakh_core.group_project_manager,jakh_core.group_finance"/>

  <record id="control_report_form" model="ir.ui.view"><field name="name">jakh.project.control.report.form</field><field name="model">jakh.project.control.report</field><field name="arch" type="xml"><form><header><button name="action_generate" type="object" string="Generate CVR" class="btn-primary"/><button name="action_pivot" type="object" string="Pivot / chart"/></header><sheet><group><field name="project_id"/><field name="company_id"/><field name="currency_id" invisible="1"/><field name="as_of_date"/></group><field name="scope_note" readonly="1"/><field name="line_ids" readonly="1"><list create="false" edit="false" delete="false"><field name="wbs_id"/><field name="original_budget" sum="Original budget"/><field name="revised_budget" sum="Revised budget"/><field name="commitments" sum="Commitments"/><field name="actual_cost" sum="Actual cost"/><field name="forecast_final_cost" sum="Forecast final cost"/><field name="forecast_to_complete" sum="Forecast to complete"/><field name="planned_value" sum="Planned value"/><field name="earned_value" sum="Earned value"/><field name="cost_performance_index" avg="CPI"/><field name="schedule_performance_index" avg="SPI"/><field name="revised_revenue" sum="Revised revenue"/><field name="certified_revenue" sum="Certified revenue"/><field name="billed_revenue" sum="Posted billing"/><field name="forecast_margin" sum="Forecast margin"/><field name="forecast_cash_net" sum="Forecast cash net"/><field name="currency_id" column_invisible="True"/></list></field></sheet></form></field></record>
  <record id="control_report_line_list" model="ir.ui.view"><field name="name">jakh.project.control.report.line.list</field><field name="model">jakh.project.control.report.line</field><field name="arch" type="xml"><list create="false" edit="false" delete="false"><field name="wbs_id"/><field name="original_budget" sum="Original budget"/><field name="revised_budget" sum="Revised budget"/><field name="commitments" sum="Commitments"/><field name="received_cost" sum="Received exposure"/><field name="actual_cost" sum="Actual cost"/><field name="forecast_final_cost" sum="Forecast final cost"/><field name="forecast_to_complete" sum="Forecast to complete"/><field name="planned_value" sum="Planned value"/><field name="earned_value" sum="Earned value"/><field name="cost_performance_index" avg="CPI"/><field name="schedule_performance_index" avg="SPI"/><field name="cash_in_forecast" sum="Cash-in forecast"/><field name="cash_out_forecast" sum="Cash-out forecast"/><field name="forecast_cash_net" sum="Forecast cash net"/><field name="original_revenue" sum="Original revenue"/><field name="variation_revenue" sum="Owner variations"/><field name="variation_cost" sum="Subcontract variations"/><field name="revised_revenue" sum="Revised revenue"/><field name="certified_revenue" sum="Certified revenue"/><field name="billed_revenue" sum="Posted billing"/><field name="forecast_margin" sum="Forecast margin"/><field name="currency_id" column_invisible="True"/></list></field></record>
  <record id="control_report_line_pivot" model="ir.ui.view"><field name="name">jakh.project.control.report.line.pivot</field><field name="model">jakh.project.control.report.line</field><field name="arch" type="xml"><pivot><field name="wbs_id" type="row"/><field name="original_budget" type="measure"/><field name="revised_budget" type="measure"/><field name="commitments" type="measure"/><field name="actual_cost" type="measure"/><field name="forecast_final_cost" type="measure"/><field name="forecast_margin" type="measure"/><field name="planned_value" type="measure"/><field name="earned_value" type="measure"/><field name="cost_performance_index" type="measure"/><field name="schedule_performance_index" type="measure"/><field name="forecast_cash_net" type="measure"/></pivot></field></record>
  <record id="action_project_control_report" model="ir.actions.act_window"><field name="name">Project cost &amp; forecast (CVR)</field><field name="res_model">jakh.project.control.report</field><field name="view_mode">form</field><field name="target">current</field></record>
  <menuitem id="menu_project_control_report" name="Project cost &amp; forecast (CVR)" parent="jakh_core.menu_reports" action="action_project_control_report" sequence="15" groups="jakh_core.group_manager,jakh_core.group_project_manager,jakh_core.group_finance"/>

  <record id="control_entry_list" model="ir.ui.view"><field name="name">jakh.project.control.entry.list</field><field name="model">jakh.project.control.entry</field><field name="arch" type="xml"><list create="false" edit="false" delete="false"><field name="date"/><field name="name"/><field name="entry_type"/><field name="project_id"/><field name="wbs_id"/><field name="partner_id" optional="show"/><field name="amount" sum="Signed amount"/><field name="currency_id" column_invisible="True"/><field name="source_model" optional="hide"/><field name="source_id" optional="hide"/><field name="provenance"/></list></field></record>
  <record id="action_control_entries" model="ir.actions.act_window"><field name="name">Project-control audit</field><field name="res_model">jakh.project.control.entry</field><field name="view_mode">list,pivot,graph</field></record>
  <menuitem id="menu_control_entries" name="Project-control audit" parent="jakh_core.menu_reports" action="action_control_entries" sequence="40" groups="jakh_core.group_manager,jakh_core.group_finance"/>

  <record id="certificate_form_variations" model="ir.ui.view"><field name="name">jakh.payment.certificate.form.variations</field><field name="model">jakh.payment.certificate</field><field name="inherit_id" ref="jakh_operations.certificate_form"/><field name="arch" type="xml"><xpath expr="//field[@name='line_ids']" position="after"><group string="Approved owner variations"><field name="variation_line_ids" readonly="state != 'draft'"><list editable="bottom"><field name="variation_id" domain="[('contract_id','=',parent.contract_id),('variation_type','=','owner'),('state','in',['approved','certified'])]"/><field name="cumulative_quantity"/></list></field></group></xpath></field></record>
</odoo>
