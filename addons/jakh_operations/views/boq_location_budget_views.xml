<odoo>
  <record id="boq_location_budget_list" model="ir.ui.view"><field name="name">jakh.boq.location.budget.list</field><field name="model">jakh.boq.location.budget</field><field name="arch" type="xml"><list><field name="name"/><field name="contract_line_id"/><field name="date"/><field name="allocation_mode"/><field name="allocated_quantity"/><field name="allocated_budget"/><field name="currency_id" column_invisible="True"/><field name="state" widget="badge"/><field name="approved_by"/><field name="approved_at"/></list></field></record>
  <record id="boq_location_budget_form" model="ir.ui.view"><field name="name">jakh.boq.location.budget.form</field><field name="model">jakh.boq.location.budget</field><field name="arch" type="xml">
    <form><header><button name="action_submit" type="object" string="Submit allocation" class="btn-primary" invisible="state != 'draft'"/>
      <button name="action_approve" type="object" string="Approve building allocation" class="btn-primary" invisible="state != 'submitted'" groups="jakh_core.group_manager,jakh_core.group_finance"/>
      <button name="action_reject" type="object" string="Reject" invisible="state != 'submitted'" groups="jakh_core.group_manager,jakh_core.group_finance"/>
      <field name="state" widget="statusbar"/></header>
      <sheet><div class="alert alert-info" role="status">Allocate original BOQ quantities and original WBS budget to real buildings or floors. Approval does not change the contract or WBS baseline. Partial quantities and unused WBS budget remain explicitly unallocated. A replacement preserves previous approved plans for historical reporting.</div>
        <group><group><field name="name" readonly="state != 'draft'"/><field name="contract_line_id" readonly="id != False"/><field name="contract_id"/><field name="project_id"/><field name="wbs_id"/><field name="company_id"/><field name="currency_id"/><field name="uom_id"/></group>
          <group><field name="date" readonly="state != 'draft'"/><field name="allocation_mode" readonly="state != 'draft'"/><field name="replaces_id" domain="[('contract_line_id','=',contract_line_id),('state','=','approved')]" readonly="state != 'draft'"/><field name="allocated_quantity"/><field name="allocated_budget"/></group></group>
        <field name="reason" readonly="state != 'draft'"/>
        <field name="line_ids" readonly="state != 'draft'"><list editable="bottom"><field name="location_id" domain="[('project_id','=',parent.project_id)]"/><field name="discipline_id" domain="[('company_id','=',parent.company_id)]"/><field name="quantity" sum="Allocated quantity"/><field name="budget_amount" sum="Allocated budget"/><field name="currency_id" column_invisible="True"/></list></field>
        <group string="Immutable approval snapshot" invisible="state != 'approved'"><field name="original_quantity"/><field name="original_wbs_budget"/><field name="unallocated_quantity"/><field name="unallocated_wbs_budget"/><field name="approved_by"/><field name="approved_at"/><field name="approved_revision"/></group>
      </sheet><chatter/>
    </form>
  </field></record>
  <record id="boq_location_budget_search" model="ir.ui.view"><field name="name">jakh.boq.location.budget.search</field><field name="model">jakh.boq.location.budget</field><field name="arch" type="xml"><search><field name="name"/><field name="contract_line_id"/><field name="contract_id"/><field name="project_id"/><filter name="approved" string="Approved" domain="[('state','=','approved')]"/></search></field></record>
  <record id="contract_boq_location_budget_access" model="ir.ui.view"><field name="name">jakh.project.contract.building.allocation</field><field name="model">jakh.project.contract</field><field name="inherit_id" ref="contract_form"/><field name="arch" type="xml"><xpath expr="//field[@name='line_ids']/list" position="inside"><button name="action_open_location_budgets" type="object" string="Building budgets" icon="fa-building-o" groups="jakh_core.group_manager,jakh_core.group_project_manager,jakh_core.group_finance"/></xpath></field></record>
</odoo>
