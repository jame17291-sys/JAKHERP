<odoo>
  <record id="control_entry_source_list" model="ir.ui.view"><field name="name">jakh.project.control.entry.source</field><field name="model">jakh.project.control.entry</field><field name="inherit_id" ref="control_entry_list"/><field name="arch" type="xml"><xpath expr="//list" position="inside"><button name="action_open_source" type="object" string="Open source" icon="fa-external-link"/></xpath></field></record>
  <record id="actual_feed_finance_form" model="ir.ui.view"><field name="name">jakh.actual.feed.finance</field><field name="model">jakh.project.actual.feed</field><field name="inherit_id" ref="actual_feed_form"/><field name="arch" type="xml">
    <xpath expr="//header/field[@name='state']" position="before"><button name="action_open_journal" type="object" string="Open posted journal" invisible="not account_move_id" groups="jakh_core.group_financial"/></xpath>
    <xpath expr="//field[@name='amount']" position="after"><field name="effect" readonly="state != 'draft'"/><field name="correction_of_id" readonly="state != 'draft'" invisible="effect != 'credit'"/><field name="correction_reason" readonly="state != 'draft'" invisible="effect != 'credit'"/><field name="journal_id" readonly="state != 'draft'" groups="jakh_core.group_financial"/><field name="expense_account_id" readonly="state != 'draft'" groups="jakh_core.group_financial"/><field name="offset_account_id" readonly="state != 'draft'" groups="jakh_core.group_financial"/><field name="account_move_id" groups="jakh_core.group_financial"/></xpath>
    <xpath expr="//button[@name='action_accept']" position="attributes"><attribute name="string">Accept and post cost</attribute></xpath>
  </field></record>
  <record id="integration_event_list" model="ir.ui.view"><field name="name">jakh.integration.event.list</field><field name="model">jakh.integration.event</field><field name="arch" type="xml"><list create="false" edit="false" delete="false"><field name="name"/><field name="kind"/><field name="project_id"/><field name="wbs_id"/><field name="create_date"/><field name="state" widget="badge"/><field name="business_state"/><field name="attempt_count"/><button name="action_retry" type="object" string="Retry" invisible="state != 'failed'"/><button name="action_open_business_record" type="object" string="Open record" invisible="state != 'prepared'"/></list></field></record>
  <record id="integration_event_form" model="ir.ui.view"><field name="name">jakh.integration.event.form</field><field name="model">jakh.integration.event</field><field name="arch" type="xml"><form create="false" edit="false" delete="false"><header><button name="action_retry" type="object" string="Retry" class="btn-primary" invisible="state != 'failed'"/><button name="action_open_business_record" type="object" string="Open record" class="btn-primary" invisible="state != 'prepared'"/><field name="state" widget="statusbar"/></header><sheet><group><group><field name="name"/><field name="kind"/><field name="external_id"/><field name="version"/><field name="company_id"/><field name="project_id"/><field name="wbs_id"/></group><group><field name="business_state"/><field name="attempt_count"/><field name="last_attempt_at"/><field name="processed_by"/><field name="payload_hash"/></group></group><field name="error_message" invisible="not error_message"/><group string="Source evidence"><field name="payload"/></group></sheet></form></field></record>
  <record id="integration_event_search" model="ir.ui.view"><field name="name">jakh.integration.event.search</field><field name="model">jakh.integration.event</field><field name="arch" type="xml"><search><field name="name"/><field name="external_id"/><field name="project_id"/><filter name="failed" string="Needs attention" domain="[('state','=','failed')]"/><filter name="project" string="Project" context="{'group_by':'project_id'}"/><filter name="source" string="Source" context="{'group_by':'kind'}"/></search></field></record>
  <record id="action_integration_events" model="ir.actions.act_window"><field name="name">Integration inbox</field><field name="res_model">jakh.integration.event</field><field name="view_mode">list,form</field></record>
  <menuitem id="menu_integration_events" name="Integration inbox" parent="jakh_core.menu_administration" action="action_integration_events" sequence="32" groups="jakh_core.group_manager,jakh_core.group_finance"/>
</odoo>
