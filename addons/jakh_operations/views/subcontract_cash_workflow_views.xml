<odoo>
  <record id="subcontract_finance_agreement_list" model="ir.ui.view"><field name="name">jakh.subcontract.finance.agreement.list</field><field name="model">jakh.subcontract.finance.agreement</field><field name="arch" type="xml"><list><field name="name"/><field name="purchase_order_id"/><field name="partner_id"/><field name="project_id"/><field name="company_id"/><field name="retention_balance"/><field name="advance_balance"/><field name="currency_id" column_invisible="True"/><field name="state" widget="badge"/></list></field></record>
  <record id="subcontract_finance_agreement_form" model="ir.ui.view"><field name="name">jakh.subcontract.finance.agreement.form</field><field name="model">jakh.subcontract.finance.agreement</field><field name="arch" type="xml"><form><header>
    <button name="action_activate" type="object" string="Approve finance terms" class="btn-primary" invisible="state != 'draft'"/>
    <button name="action_prepare_advance" type="object" string="Request supplier advance" invisible="state != 'active' or advance_percent == 0"/>
    <button name="action_prepare_retention_release" type="object" string="Release retention" invisible="state != 'active' or retention_balance &lt;= 0"/>
    <button name="action_close" type="object" string="Close agreement" invisible="state != 'active'"/>
    <button name="action_reopen" type="object" string="Reopen agreement" groups="jakh_core.group_manager" invisible="state != 'closed'"/>
    <field name="state" widget="statusbar"/>
  </header><sheet><group><group><field name="name" readonly="state != 'draft'"/><field name="purchase_order_id" readonly="state != 'draft'" domain="[('jakh_request_id','!=',False),('state','in',['purchase','done'])]"/><field name="project_id"/><field name="wbs_id"/><field name="partner_id"/><field name="company_id"/></group><group><field name="journal_id" readonly="state != 'draft'"/><field name="currency_id" invisible="1"/><field name="retention_balance"/><field name="advance_balance"/><field name="approved_by"/><field name="approved_at"/></group></group>
    <group><group string="Retention terms"><field name="retention_percent" readonly="state != 'draft'"/><field name="retention_cap" readonly="state != 'draft'"/><field name="retention_account_id" readonly="state != 'draft'" domain="[('account_type','=','liability_current')]"/></group><group string="Advance terms"><field name="advance_percent" readonly="state != 'draft'"/><field name="advance_cap" readonly="state != 'draft'"/><field name="recovery_percent" readonly="state != 'draft'"/><field name="advance_account_id" readonly="state != 'draft'" domain="[('account_type','in',['asset_prepayments','asset_current','asset_non_current'])]"/></group></group>
    <notebook><page string="Supplier certificates"><field name="certificate_ids" readonly="1"><list create="false" delete="false"><field name="name"/><field name="service_entry_id"/><field name="gross_amount"/><field name="retention_amount"/><field name="recovery_amount"/><field name="net_before_tax"/><field name="invoice_id"/><field name="state" widget="badge"/></list></field></page><page string="Advances and releases"><field name="cash_document_ids" readonly="1"><list create="false" delete="false"><field name="name"/><field name="document_type"/><field name="amount"/><field name="invoice_id"/><field name="state" widget="badge"/></list></field></page></notebook>
  </sheet><chatter/></form></field></record>
  <record id="subcontract_finance_agreement_search" model="ir.ui.view"><field name="name">jakh.subcontract.finance.agreement.search</field><field name="model">jakh.subcontract.finance.agreement</field><field name="arch" type="xml"><search><field name="name"/><field name="purchase_order_id"/><field name="project_id"/><field name="partner_id"/><filter name="active" string="Active" domain="[('state','=','active')]"/><filter name="project_group" string="Project" context="{'group_by':'project_id'}"/><filter name="supplier_group" string="Supplier" context="{'group_by':'partner_id'}"/></search></field></record>
  <record id="action_subcontract_finance_agreements" model="ir.actions.act_window"><field name="name">Subcontract finance</field><field name="res_model">jakh.subcontract.finance.agreement</field><field name="view_mode">list,form</field></record>
  <menuitem id="menu_subcontract_finance" name="Subcontract finance" parent="jakh_core.menu_construction" action="action_subcontract_finance_agreements" sequence="56" groups="jakh_core.group_manager,jakh_core.group_finance"/>
  <record id="subcontract_payment_certificate_list" model="ir.ui.view"><field name="name">jakh.subcontract.payment.certificate.list</field><field name="model">jakh.subcontract.payment.certificate</field><field name="arch" type="xml"><list><field name="name"/><field name="agreement_id"/><field name="service_entry_id"/><field name="project_id"/><field name="date"/><field name="gross_amount"/><field name="retention_amount"/><field name="recovery_amount"/><field name="net_before_tax"/><field name="currency_id" column_invisible="True"/><field name="state" widget="badge"/></list></field></record>
  <record id="subcontract_payment_certificate_form" model="ir.ui.view"><field name="name">jakh.subcontract.payment.certificate.form</field><field name="model">jakh.subcontract.payment.certificate</field><field name="arch" type="xml"><form><header>
    <button name="action_submit" type="object" string="Submit certificate" class="btn-primary" invisible="state != 'draft'"/>
    <button name="action_approve" type="object" string="Approve certificate" class="btn-primary" invisible="state != 'submitted'"/>
    <button name="action_create_bill" type="object" string="Create supplier bill" class="btn-primary" invisible="state != 'approved'"/>
    <button name="action_register_payment" type="object" string="Register payment" invisible="state != 'billed'"/>
    <button name="action_cancel" type="object" string="Cancel certificate" invisible="state == 'cancelled'"/>
    <field name="state" widget="statusbar"/>
  </header><sheet><group><group><field name="name" readonly="state != 'draft'"/><field name="agreement_id" readonly="state != 'draft'" domain="[('state','=','active')]"/><field name="service_entry_id" readonly="state != 'draft'" domain="[('purchase_order_id','=',purchase_order_id),('state','=','approved')]"/><field name="purchase_order_id"/><field name="project_id"/><field name="wbs_id"/><field name="company_id"/></group><group><field name="date" readonly="state != 'draft'"/><field name="available_quantity"/><field name="quantity"/><field name="currency_id" invisible="1"/><field name="gross_amount"/><field name="retention_amount"/><field name="recovery_amount"/><field name="net_before_tax"/><field name="approved_by"/><field name="invoice_id"/></group></group></sheet><chatter/></form></field></record>
  <record id="action_subcontract_payment_certificates" model="ir.actions.act_window"><field name="name">Supplier certificates</field><field name="res_model">jakh.subcontract.payment.certificate</field><field name="view_mode">list,form</field></record>
  <menuitem id="menu_subcontract_payment_certificates" name="Supplier certificates" parent="menu_subcontract_finance" action="action_subcontract_payment_certificates" sequence="10" groups="jakh_core.group_manager,jakh_core.group_finance"/>
  <record id="subcontract_cash_document_list" model="ir.ui.view"><field name="name">jakh.subcontract.cash.document.list</field><field name="model">jakh.subcontract.cash.document</field><field name="arch" type="xml"><list><field name="name"/><field name="agreement_id"/><field name="project_id"/><field name="document_type"/><field name="date"/><field name="amount"/><field name="currency_id" column_invisible="True"/><field name="invoice_id"/><field name="state" widget="badge"/></list></field></record>
  <record id="subcontract_cash_document_form" model="ir.ui.view"><field name="name">jakh.subcontract.cash.document.form</field><field name="model">jakh.subcontract.cash.document</field><field name="arch" type="xml"><form><header>
    <button name="action_submit" type="object" string="Submit cash request" class="btn-primary" invisible="state != 'draft'"/>
    <button name="action_approve" type="object" string="Approve cash request" class="btn-primary" invisible="state != 'submitted'"/>
    <button name="action_create_bill" type="object" string="Create supplier bill" class="btn-primary" invisible="state != 'approved'"/>
    <button name="action_register_payment" type="object" string="Register payment" invisible="state != 'billed'"/>
    <button name="action_cancel" type="object" string="Cancel cash request" invisible="state == 'cancelled'"/>
    <field name="state" widget="statusbar"/>
  </header><sheet><group><group><field name="name" readonly="state != 'draft'"/><field name="agreement_id" readonly="state != 'draft'" domain="[('state','=','active')]"/><field name="purchase_order_id"/><field name="project_id"/><field name="wbs_id"/><field name="company_id"/></group><group><field name="document_type" readonly="state != 'draft'"/><field name="date" readonly="state != 'draft'"/><field name="currency_id" invisible="1"/><field name="amount" readonly="state != 'draft'"/><field name="approved_by"/><field name="invoice_id"/></group></group><group><field name="reason" readonly="state != 'draft'"/></group></sheet><chatter/></form></field></record>
  <record id="action_subcontract_cash_documents" model="ir.actions.act_window"><field name="name">Supplier advances and retention releases</field><field name="res_model">jakh.subcontract.cash.document</field><field name="view_mode">list,form</field></record>
  <menuitem id="menu_subcontract_cash_documents" name="Supplier advances and retention releases" parent="menu_subcontract_finance" action="action_subcontract_cash_documents" sequence="20" groups="jakh_core.group_manager,jakh_core.group_finance"/>
</odoo>
