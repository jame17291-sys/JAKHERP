<odoo>
  <record id="contract_baseline_cost_form" model="ir.ui.view">
    <field name="name">jakh.project.contract.baseline.cost.form</field><field name="model">jakh.project.contract</field>
    <field name="inherit_id" ref="jakh_operations.contract_form"/>
    <field name="arch" type="xml">
      <xpath expr="//header" position="inside"><button name="action_new_boq_revision" type="object" string="Revise BOQ" groups="jakh_core.group_manager,jakh_core.group_project_manager,jakh_core.group_finance" invisible="state != 'active'"/><button name="action_current_boq" type="object" string="Current consolidated BOQ" groups="jakh_core.group_manager,jakh_core.group_project_manager,jakh_core.group_finance"/></xpath>
      <xpath expr="//field[@name='finance_approved_by']" position="after"><field name="original_contract_value" groups="jakh_core.group_financial"/><field name="current_contract_value" groups="jakh_core.group_financial"/></xpath>
      <xpath expr="//field[@name='line_ids']/list/field[@name='unit_price']" position="before"><field name="original_direct_unit_cost" groups="jakh_core.group_financial"/><field name="original_cost_total" groups="jakh_core.group_financial" optional="show"/><field name="original_budget_total" groups="jakh_core.group_financial" optional="show"/></xpath>
      <xpath expr="//notebook" position="inside"><page string="BOQ revision history" groups="jakh_core.group_financial"><field name="boq_revision_ids" readonly="1"><list create="false" edit="false" delete="false"><field name="name"/><field name="approved_number"/><field name="date"/><field name="state"/><field name="approved_by"/><field name="approved_at"/></list></field></page></xpath>
    </field>
  </record>
  <record id="boq_revision_list" model="ir.ui.view"><field name="name">jakh.contract.boq.revision.list</field><field name="model">jakh.contract.boq.revision</field><field name="arch" type="xml"><list><field name="name"/><field name="contract_id"/><field name="project_id"/><field name="date"/><field name="approved_number"/><field name="state" widget="badge"/><field name="approved_by"/></list></field></record>
  <record id="boq_revision_form" model="ir.ui.view">
    <field name="name">jakh.contract.boq.revision.form</field><field name="model">jakh.contract.boq.revision</field><field name="arch" type="xml">
      <form><header><button name="action_submit" type="object" string="Submit BOQ revision" class="btn-primary" invisible="state != 'draft'"/><button name="action_approve" type="object" string="Approve scope and budget" class="btn-primary" groups="jakh_core.group_manager,jakh_core.group_finance" invisible="state != 'submitted'"/><button name="action_reject" type="object" string="Reject" groups="jakh_core.group_manager,jakh_core.group_finance" invisible="state != 'submitted'"/><field name="state" widget="statusbar"/></header>
        <sheet><div class="alert alert-info" role="status">A revision preserves the original contract and BOQ. Approval publishes owner variations and controlled WBS budget changes on this same project. Omit only unperformed original scope; previously certified work requires a separate financial correction.</div>
          <group><group><field name="name" readonly="state != 'draft'"/><field name="contract_id" readonly="state != 'draft'" domain="[('state','=','active')]"/><field name="project_id"/><field name="company_id"/><field name="currency_id" invisible="1"/><field name="date" readonly="state != 'draft'"/></group><group><field name="basis_revision"/><field name="approved_number"/><field name="approved_by"/><field name="approved_at"/></group></group>
          <field name="reason" readonly="state != 'draft'"/>
          <field name="line_ids" readonly="state != 'draft'"><list editable="bottom"><field name="effect"/><field name="contract_line_id" domain="[('contract_id','=',parent.contract_id)]"/><field name="code"/><field name="name"/><field name="wbs_id" domain="[('project_id','=',parent.project_id)]"/><field name="location_id" domain="[('project_id','=',parent.project_id)]" optional="show"/><field name="discipline_id" domain="[('company_id','=',parent.company_id)]" optional="show"/><field name="uom_id"/><field name="quantity"/><field name="direct_unit_cost" groups="jakh_core.group_financial"/><field name="unit_price" groups="jakh_core.group_financial"/><field name="budget_delta" groups="jakh_core.group_financial"/><field name="variation_id" optional="hide"/></list></field>
          <group string="Published budget amendments" invisible="state != 'approved'"><field name="budget_revision_ids" readonly="1" widget="many2many_tags"/></group>
        </sheet><chatter/></form>
    </field>
  </record>
  <record id="action_boq_revisions" model="ir.actions.act_window"><field name="name">BOQ revisions</field><field name="res_model">jakh.contract.boq.revision</field><field name="view_mode">list,form</field></record>
  <menuitem id="menu_boq_revisions" name="BOQ revisions" parent="menu_project_contracts" action="action_boq_revisions" sequence="15" groups="jakh_core.group_manager,jakh_core.group_project_manager,jakh_core.group_finance"/>
  <record id="current_boq_report_form" model="ir.ui.view">
    <field name="name">jakh.contract.boq.report.form</field><field name="model">jakh.contract.boq.report</field><field name="arch" type="xml"><form><header><button name="action_generate" type="object" string="Refresh approved BOQ" class="btn-primary"/></header><sheet><group><field name="contract_id"/><field name="company_id"/><field name="currency_id"/><field name="original_value"/><field name="revised_value"/><field name="generated_at"/></group><div class="alert alert-info" role="status">Original quantities and rates remain preserved. The current BOQ includes approved additions and unperformed scope omissions; separate negative financial adjustments remain visible as their own rows.</div><field name="line_ids" readonly="1"><list create="false" edit="false" delete="false"><field name="code"/><field name="name"/><field name="wbs_id"/><field name="location_id" optional="show"/><field name="discipline_id" optional="show"/><field name="uom_id"/><field name="original_quantity"/><field name="current_quantity"/><field name="unit_price"/><field name="selling_value" sum="Revised contract value"/><field name="contract_line_id" optional="hide"/><field name="variation_id" optional="hide"/></list></field></sheet></form></field>
  </record>
</odoo>
