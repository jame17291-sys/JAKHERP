<odoo>
  <record id="view_case_list" model="ir.ui.view"><field name="name">jakh.assurance.case.list</field><field name="model">jakh.assurance.case</field><field name="arch" type="xml"><list decoration-danger="is_overdue"><field name="name"/><field name="kind"/><field name="project_id"/><field name="responsible_id"/><field name="due_date"/><field name="severity" widget="badge"/><field name="state" widget="badge"/><field name="is_overdue" column_invisible="True"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
  <record id="view_case_form" model="ir.ui.view"><field name="name">jakh.assurance.case.form</field><field name="model">jakh.assurance.case</field><field name="arch" type="xml"><form><header><button name="action_submit" string="Submit" type="object" class="btn-primary" invisible="state != 'draft'"/><button name="action_start" string="Accept / Start" type="object" invisible="state != 'submitted'" groups="jakh_core.group_quality"/><button name="action_resolve" string="Resolve" type="object" invisible="state != 'in_progress'"/><button name="action_close" string="Verify &amp; Close" type="object" class="btn-primary" invisible="state != 'resolved'" groups="jakh_core.group_quality"/><button name="action_cancel" string="Cancel" type="object" invisible="state not in ['draft', 'submitted']" groups="jakh_core.group_quality"/><field name="state" widget="statusbar" statusbar_visible="draft,submitted,in_progress,resolved,closed"/></header><sheet><group><field name="name"/><field name="kind"/><field name="project_id"/><field name="wbs_id" domain="[('project_id', '=', project_id)]"/><field name="responsible_id"/><field name="due_date"/><field name="severity"/><field name="authority_reference"/><field name="permit_start" invisible="kind != 'permit'"/><field name="permit_end" invisible="kind != 'permit'"/></group><notebook><page string="Details &amp; Hazards"><field name="description"/></page><page string="Resolution"><field name="resolution"/></page><page string="Lifecycle"><group><field name="submitted_at"/><field name="resolved_at"/><field name="closed_at"/><field name="verified_by_id"/></group></page></notebook><div class="alert alert-info">Add verification files using the attachment control in the chatter. Standards references require project approval and do not establish statutory compliance.</div></sheet><chatter/></form></field></record>
  <record id="view_case_search" model="ir.ui.view"><field name="name">jakh.assurance.case.search</field><field name="model">jakh.assurance.case</field><field name="arch" type="xml"><search><field name="name"/><field name="project_id"/><field name="responsible_id"/><filter name="open" string="Open" domain="[('state', 'not in', ['closed', 'cancelled'])]"/><filter name="overdue" string="Overdue" domain="[('is_overdue', '=', True)]"/><filter name="my" string="Assigned to Me" domain="[('responsible_id', '=', uid)]"/><filter name="group_kind" string="Type" context="{'group_by': 'kind'}"/><filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/><filter name="group_state" string="Status" context="{'group_by': 'state'}"/></search></field></record>
  <record id="view_case_pivot" model="ir.ui.view"><field name="name">jakh.assurance.case.pivot</field><field name="model">jakh.assurance.case</field><field name="arch" type="xml"><pivot string="Quality / HSE Actions"><field name="project_id" type="row"/><field name="kind" type="col"/></pivot></field></record>
  <record id="action_cases" model="ir.actions.act_window"><field name="name">Quality &amp; HSE Actions</field><field name="res_model">jakh.assurance.case</field><field name="view_mode">list,form,pivot,graph,calendar</field></record>
  <record id="view_case_calendar" model="ir.ui.view"><field name="name">jakh.assurance.case.calendar</field><field name="model">jakh.assurance.case</field><field name="arch" type="xml"><calendar string="Inspection / Action Calendar" date_start="due_date" color="kind"><field name="name"/><field name="responsible_id"/><field name="project_id"/></calendar></field></record>
  <record id="view_document_list" model="ir.ui.view"><field name="name">jakh.document.list</field><field name="model">jakh.document</field><field name="arch" type="xml"><list><field name="code"/><field name="name"/><field name="kind"/><field name="project_id"/><field name="jurisdiction"/><field name="authority" optional="show"/><field name="standard_edition" optional="show"/></list></field></record>
  <record id="view_document_form" model="ir.ui.view"><field name="name">jakh.document.form</field><field name="model">jakh.document</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="code"/><field name="project_id"/><field name="wbs_id" domain="[('project_id', '=', project_id)]"/><field name="kind"/><field name="jurisdiction"/><field name="authority"/><field name="standard_edition"/><field name="effective_date"/></group><notebook><page string="Revision Register"><field name="revision_ids" context="{'default_project_id': project_id}"><list><field name="name"/><field name="reviewer_id"/><field name="due_date"/><field name="state" widget="badge"/><field name="submitted_at"/><field name="completed_at"/></list></field></page></notebook></sheet><chatter/></form></field></record>
  <record id="action_documents" model="ir.actions.act_window"><field name="name">Drawings, Submittals &amp; Specifications</field><field name="res_model">jakh.document</field><field name="view_mode">list,form</field></record>
  <record id="view_revision_list" model="ir.ui.view"><field name="name">jakh.document.revision.list</field><field name="model">jakh.document.revision</field><field name="arch" type="xml"><list><field name="document_id"/><field name="name"/><field name="project_id"/><field name="reviewer_id"/><field name="due_date"/><field name="state" widget="badge"/><field name="cycle_days" optional="show"/><field name="submitted_at" optional="hide"/></list></field></record>
  <record id="view_revision_form" model="ir.ui.view"><field name="name">jakh.document.revision.form</field><field name="model">jakh.document.revision</field><field name="arch" type="xml"><form><header><button name="action_submit" string="Submit Revision" type="object" class="btn-primary" invisible="state != 'draft'"/><button name="action_approve" string="Approve" type="object" class="btn-primary" invisible="state != 'submitted'"/><button name="action_reject" string="Reject" type="object" invisible="state != 'submitted'"/><field name="state" widget="statusbar"/></header><sheet><group><field name="document_id" readonly="state != 'draft'"/><field name="name" readonly="state != 'draft'"/><field name="reviewer_id" readonly="state != 'draft'"/><field name="due_date" readonly="state != 'draft'"/><field name="project_id"/><field name="submitted_at"/><field name="completed_at"/><field name="approved_by_id"/><field name="cycle_days"/></group><field name="summary" readonly="state != 'draft'"/><div class="alert alert-info">Attach the revision file before submission. Submitted files and revision metadata are locked; changes require a new revision.</div></sheet><chatter/></form></field></record>
  <record id="view_revision_search" model="ir.ui.view"><field name="name">jakh.document.revision.search</field><field name="model">jakh.document.revision</field><field name="arch" type="xml"><search><field name="document_id"/><field name="reviewer_id"/><field name="project_id"/><filter name="submitted" string="Awaiting Review" domain="[('state', '=', 'submitted')]"/><filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/><filter name="group_reviewer" string="Reviewer" context="{'group_by': 'reviewer_id'}"/><filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/></search></field></record>
  <record id="view_revision_pivot" model="ir.ui.view"><field name="name">jakh.document.revision.pivot</field><field name="model">jakh.document.revision</field><field name="arch" type="xml"><pivot string="Document Turnaround"><field name="reviewer_id" type="row"/><field name="state" type="col"/><field name="cycle_days" type="measure"/></pivot></field></record>
  <record id="action_revisions" model="ir.actions.act_window"><field name="name">Document Lifecycle &amp; Turnaround</field><field name="res_model">jakh.document.revision</field><field name="view_mode">list,form,pivot,graph</field></record>
  <record id="action_document_turnaround" model="ir.actions.act_window"><field name="name">Completed Review Turnaround</field><field name="res_model">jakh.document.revision</field><field name="view_mode">pivot,graph,list,form</field><field name="domain">[('state', 'in', ['approved', 'rejected'])]</field></record>
  <menuitem id="menu_cases" name="Quality &amp; HSE Actions" parent="jakh_core.menu_assurance" action="action_cases" sequence="10"/>
  <menuitem id="menu_documents" name="Document Control &amp; Specifications" parent="jakh_core.menu_assurance" action="action_documents" sequence="20"/>
  <menuitem id="menu_revisions" name="Reviews &amp; Turnaround" parent="jakh_core.menu_assurance" action="action_revisions" sequence="30"/>
  <menuitem id="menu_quality_reports" name="Quality / HSE Reporting" parent="jakh_core.menu_reports" action="action_cases" sequence="40"/>
  <menuitem id="menu_document_reports" name="Document Lifecycle Reporting" parent="jakh_core.menu_reports" action="action_document_turnaround" sequence="50"/>
</odoo>
