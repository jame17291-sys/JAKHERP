<odoo>
  <record id="drawing_context_form" model="ir.ui.view"><field name="name">jakh.document.location.form</field><field name="model">jakh.document</field><field name="inherit_id" ref="jakh_assurance.view_document_form"/><field name="arch" type="xml"><xpath expr="//field[@name='wbs_id']" position="after"><field name="location_id" domain="[('project_id','=',project_id)]"/><field name="discipline_id"/></xpath></field></record>
  <record id="drawing_context_list" model="ir.ui.view"><field name="name">jakh.document.location.list</field><field name="model">jakh.document</field><field name="inherit_id" ref="jakh_assurance.view_document_list"/><field name="arch" type="xml"><xpath expr="//field[@name='project_id']" position="after"><field name="location_id" optional="show"/><field name="discipline_id" optional="show"/></xpath></field></record>
  <record id="drawing_revision_context_list" model="ir.ui.view"><field name="name">jakh.document.revision.location.list</field><field name="model">jakh.document.revision</field><field name="inherit_id" ref="jakh_assurance.view_revision_list"/><field name="arch" type="xml"><xpath expr="//field[@name='project_id']" position="after"><field name="location_id" optional="show"/><field name="discipline_id" optional="show"/><field name="submitted_at" optional="show"/><field name="completed_at" optional="show"/></xpath></field></record>
  <record id="drawing_revision_context_search" model="ir.ui.view"><field name="name">jakh.document.revision.location.search</field><field name="model">jakh.document.revision</field><field name="inherit_id" ref="jakh_assurance.view_revision_search"/><field name="arch" type="xml"><xpath expr="//search" position="inside"><field name="location_id"/><field name="discipline_id"/><filter name="by_location" string="Building / floor" context="{'group_by':'location_id'}"/><filter name="by_discipline" string="Discipline" context="{'group_by':'discipline_id'}"/></xpath></field></record>
</odoo>
